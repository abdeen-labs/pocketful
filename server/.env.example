# Copy to .env and fill in. Never commit the filled-in copy — .gitignore
# excludes .env, and *.pem / *.p12 / *.p8 / *.key are excluded too.
#
# The base64 values below are the whole PEM/p8 FILE encoded, not the
# certificate body: `base64 -i wwdr.pem`. See INSTRUCTIONS.md, Part 1.

# --- Required ---------------------------------------------------------------

# Your Apple Pass Type ID, e.g. pass.dev.abdeen.pocketful
PASS_TYPE_IDENTIFIER=

# Your 10-character Apple Team ID
TEAM_IDENTIFIER=

# Bearer token for the management API (/api/*). The server refuses to start
# without it. Generate a long random value, e.g. `openssl rand -hex 32`.
API_TOKEN=

# base64 of wwdr.pem — Apple's WWDR intermediate certificate
WWDR_CERT_BASE64=

# base64 of signerCert.pem — your pass signing certificate
SIGNER_CERT_BASE64=

# base64 of signerKey.pem — the signing certificate's private key
SIGNER_KEY_BASE64=

# --- Optional ---------------------------------------------------------------

# Passphrase for signerKey.pem, if you exported it with one
SIGNER_KEY_PASSPHRASE=

# Listen port. Railway injects this; default 3000.
PORT=

# Shown on the pass when the spec omits organizationName. Default "Pocketful".
ORGANIZATION_NAME=

# How long a signed pass stays downloadable, in seconds. Default 900 (15 min).
PASS_TTL_SECONDS=

# Public origin stamped into updatable passes as webServiceURL, e.g.
# https://pass.example.dev — set this in any real deployment. Without it the
# server falls back to the request's Host header.
PUBLIC_BASE_URL=

# Where the SQLite database lives. Default ./data locally; the Dockerfile sets
# /data, which is where a Railway Volume should be mounted.
DATA_DIR=

# --- Optional: APNs push for over-the-air pass updates ----------------------
# Set both or neither. Without them, updatable passes refresh only when iOS
# decides to poll on its own.

# The 10-character Key ID of your APNs auth key
APNS_KEY_ID=

# base64 of the whole AuthKey_XXXXXXXXXX.p8 file
APNS_KEY_BASE64=
