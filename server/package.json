{
  "name": "pocketful-server",
  "version": "1.0.0",
  "private": true,
  "description": "Builds, signs and serves Apple Wallet passes from a JSON spec",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "apns2": "^12.2.0",
    "better-sqlite3": "^13.0.3",
    "express": "^4.22.3",
    "express-rate-limit": "8.7.3",
    "passkit-generator": "^3.7.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.23",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
